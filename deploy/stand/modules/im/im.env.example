# Модуль «Менеджер инцидентов». Скопировать в im.env (в git не идёт) и поправить пути.

IM_SERVER_DIR="$HOME/Work/incident-manager-server"   # сервер МИ, ветка feature/im_operator
IM_WEB_DIR="$HOME/Work/incident-manager"             # конфигуратор и место оператора, ветка feature/im_operator

# База МИ в контейнере ac_db (локальная, пароль придуман для стенда)
IM_DB_NAME="imdb"
IM_DB_USER="im"
IM_DB_PASS="im_local_dev"

IM_SERVER_PORT=5000   # сервер МИ на машине
IM_VITE_PORT=5173     # Vite конфигуратора на машине
