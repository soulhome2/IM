# Локальное облако (стек ac). Скопировать в cloud.env (в git не идёт) и поправить пути.

CLOUD_DIR="$HOME/Work/axxoncloudgo"   # облако, ветка epic/CLOUD-23284-perms-i18n

# Интерфейс облака — ОДНО из двух:
UI_ZIP="$HOME/Work/ui-artifacts/ASIP-AX1047-3/ui-AxxonNet.zip"   # 1) архив Bamboo (план ASIP-AX)
UI_BUILD_DIR=""                                                  # 2) каталог своей сборки axxoncloud-ui; если задан — берётся он

UPLOADER_IMG="$HOME/Work/ui-artifacts/ASIP-UP-22/uploader.img"   # образ uploader (Bamboo, ASIP-UP); пусто — пропустить
GO_ENV_FILE="$HOME/go/offline-env.sh"                            # Go без VPN (GOPROXY из libs.zip); пусто — обычный go

STAND_DIR="$HOME/Work/stand"   # журналы, pid, бинарники, конфиг шлюза, бэкапы

# Пользователь стенда в группе cloud-admin. Пароль — только в файле с правами 600.
TEST_EMAIL="test@axxonnet.test"
TEST_PASS_FILE="$HOME/Work/stand/test-operator.pass"

DEV_LOGIN=1   # страница входа без пароля https://axxonnet.test/dev-login.html: 1 — ставить, 0 — нет
