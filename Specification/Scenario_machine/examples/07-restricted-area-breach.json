      },
      "transitions": {
        "default": {
          "goto": "compare_with_normal",
          "macro": {
            "name": "MACRO_FULL_LOCKDOWN + MACRO_DISPATCH_GUARD_TEAM",
            "args": {}
          }
        },
        "rules": [
          {
            "condition": {
              "or": [
                {
                  "in": [
                    "armed",
                    {
                      "var": "selected"
                    }
                  ]
                },
                {
                  "in": [
                    "destroying",
                    {
                      "var": "selected"
                    }
                  ]
                }
              ]
            },
            "goto": "compare_with_normal",
            "macro": {
              "name": "MACRO_FULL_LOCKDOWN + MACRO_CALL_POLICE_URGENT",
              "args": {}
            }
          },
          {
            "condition": {
              "in": [
                "calm",
                {
                  "var": "selected"
                }
              ]
            },
            "goto": "compare_with_normal",
            "macro": {
              "name": "MACRO_DISPATCH_GUARD",
              "args": {}
            }
          }
        ]
