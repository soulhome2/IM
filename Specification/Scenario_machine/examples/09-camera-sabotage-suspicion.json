            "condition": {
              "==": [
                {
                  "var": "value"
                },
                "vandalism"
              ]
            },
            "goto": "vandalism_path",
            "macro": {
              "name": "MACRO_DISPATCH_GUARD",
              "args": {}
            }
          },
          {
            "condition": {
              "==": [
                {
                  "var": "value"
                },
                "weather"
              ]
            },
            "goto": "weather_path",
            "macro": null
          },
          {
            "condition": {
              "==": [
                {
                  "var": "value"
                },
                "tech_fault"
              ]
            },
            "goto": "tech_fault_path",
            "macro": {
              "name": "MACRO_CREATE_SUPPORT_TICKET",
              "args": {}
            }
          }
        ]
      }
