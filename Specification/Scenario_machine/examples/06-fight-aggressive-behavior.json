              "args": {}
            }
          },
          {
            "condition": {
              "or": [
                {
                  "==": [
                    {
                      "var": "value"
                    },
                    "fight"
                  ]
                },
                {
                  "==": [
                    {
                      "var": "value"
                    },
                    "shoving"
                  ]
                }
              ]
            },
            "goto": "supervisor_briefing",
            "macro": {
              "name": "MACRO_DISPATCH_GUARD_TEAM",
              "args": {}
            }
          },
          {
            "condition": {
              "==": [
                {
                  "var": "value"
                },
                "ended"
              ]
            },
            "goto": "evidence_snapshot",
            "macro": null
          }
        ]
      }
