{
  "scenario": {
    "id": "dbeb5a40-5495-7b35-84e5-6c5d7d30b246",
    "name": "Подозрительный предмет",
    "description": "Аналитика обнаружила оставленный предмет в публичной зоне. Оператор оценивает риски по чек-листу. Маршрутизация зависит от количества подтверждённых факторов риска.",
    "version": 1,
    "createdAt": "2026-04-29T00:00:00Z",
    "updatedAt": "2026-04-29T00:00:00Z",
    "initialStep": "object_visible"
  },
  "steps": [
    {
      "id": "object_visible",
      "type": "RadioButton",
      "title": "Шаг 1. Подтверждение объекта",
      "description": "",
      "revisitable": true,
      "multitasking": false,
      "report": false,
      "finish": false,
      "view": {
        "label": "Объект действительно присутствует в кадре?",
        "required": true,
        "default": null,
        "options": [
          {
            "id": "yes",
            "label": "Да, объект виден"
          },
          {
            "id": "removed",
            "label": "Уже убран (владелец вернулся)"
          },
          {
            "id": "false_alarm",
            "label": "Ошибка аналитики — объекта нет"
          }
        ]
      },
      "transitions": {
        "default": {
          "goto": "risk_factors",
          "macro": null
        },
        "rules": [
          {
            "condition": {
              "in": [
                {
                  "var": "value"
                },
                [
                  "removed",
                  "false_alarm"
                ]
              ]
            },
            "goto": "btn_close_resolved",
            "macro": null
          }
        ]
      }
    },
    {
      "id": "risk_factors",
      "type": "Checkbox",
      "title": "Шаг 2. Чек-лист рисков",
      "description": "",
      "revisitable": true,
      "multitasking": false,
      "report": false,
      "finish": false,
      "view": {
        "label": "Какие признаки риска присутствуют? (отметьте все применимые)",
        "minSelected": 1,
        "maxSelected": 8,
        "options": [
          {
            "id": "crowded_area",
            "label": "Высокая плотность людей рядом",
            "default": false
          },
          {
            "id": "near_critical",
            "label": "Рядом с критической инфраструктурой (вентиляция, серверная)",
            "default": false
          },
          {
            "id": "size_large",
            "label": "Размер крупный (чемодан, рюкзак, коробка)",
            "default": false
          },
          {
            "id": "suspicious_owner",
            "label": "Поведение владельца было подозрительным",
            "default": false
          },
          {
            "id": "wires_visible",
            "label": "Видны провода / посторонние элементы",
            "default": false
          },
          {
            "id": "leaking",
            "label": "Видна утечка жидкости / запах",
            "default": false
          },
          {
            "id": "long_unattended",
            "label": "Объект без присмотра > 15 минут",
            "default": false
          },
          {
            "id": "none_found",
            "label": "Признаков риска нет",
            "default": false
          }
        ]
      },
      "transitions": {
        "default": {
          "goto": "low_risk_action",
          "macro": null
        },
        "rules": [
          {
            "condition": {
              "or": [
                {
                  "in": [
                    "wires_visible",
                    {
                      "var": "selected"
                    }
                  ]
                },
                {
                  "in": [
                    "leaking",
                    {
                      "var": "selected"
                    }
                  ]
                },
                {
                  "in": [
                    "near_critical",
                    {
                      "var": "selected"
                    }
                  ]
                }
              ]
            },
            "goto": "high_risk_photo",
            "macro": {
              "name": "MACRO_AREA_LOCKDOWN",
              "args": {}
            }
          },
          {
            "condition": {
              "or": [
                {
                  "in": [
                    "crowded_area",
                    {
                      "var": "selected"
                    }
                  ]
                },
                {
                  "in": [
                    "size_large",
                    {
                      "var": "selected"
                    }
                  ]
                },
                {
                  "in": [
                    "suspicious_owner",
                    {
                      "var": "selected"
                    }
                  ]
                },
                {
                  "in": [
                    "long_unattended",
                    {
                      "var": "selected"
                    }
                  ]
                }
              ]
            },
            "goto": "medium_risk_action",
            "macro": null
          }
        ]
      }
    },
