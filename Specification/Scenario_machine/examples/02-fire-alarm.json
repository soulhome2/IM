                "fire_visible"
              ]
            },
            "goto": "fire_photo",
            "macro": {
              "name": "MACRO_CALL_FIRE_DEPT + MACRO_LOCK_ELEVATORS",
              "args": {}
            }
          },
          {
            "condition": {
              "==": [
                {
                  "var": "value"
                },
                "smoke_only"
              ]
            },
            "goto": "fire_photo",
            "macro": {
              "name": "MACRO_LOCAL_ALERT",
              "args": {}
            }
          }
        ]
      }
