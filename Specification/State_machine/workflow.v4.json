  "validation": {
    "$comment": "§14.7. Проверки при сохранении схемы. Бэкенд обязан выполнять их до публикации.",
    "rules": [
      "unreachable_state",
      "non_terminal_state_without_outgoing",
      "state_without_incoming",
      "role_state_without_any_transition",
      "target_role_cannot_exit_state",
      "duplicate_hotkey",
      "unknown_permission_reference",
      "unused_permission",
      "claim_without_exit_permission"
    ],
    "claimWithoutExitPermission": {
      "$comment": "§10.3. Роль с incident:claim обязана иметь хотя бы одно из перечисленного, иначе схема не публикуется.",
      "requiresAnyOf": ["incident:hold", "incident:release", "incident:cancel"]
    }
  },

  "invariants": {
    "$comment": "§10.1. Проверяются сервером на каждом переходе.",
