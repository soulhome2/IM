# Сервер МИ на машине против локального облака (стек ac). Скопировать в $STAND_DIR/im-server.env и поправить под себя.
# Значения локальные, придуманы для стенда: роль im и база imdb заводятся в ac_db (30-local-stand.md, «Шаг 2»).
IM_DB_URL=postgresql://im:im_local_dev@127.0.0.1:5432/imdb?sslmode=disable
IM_SERVER_PORT=5000
# Облако: introspect всегда по https://, служебные /ac/v1/* — по http:// на порт сервиса ac_backend.
IM_CLOUD_URL=axxonnet.test
IM_S2S_CLOUD_URL=127.0.0.1:8000
IM_LOG_LEVEL=debug
# Вход эмулятора агента без ключа (заголовок X-Dev-Agent). Только для стенда.
IM_AGENT_DEV_AUTH=true
# Только для проверки планировщика (im-machine-patch.sh, check-operator-scheduler.sh); обычно не задавать:
# IM_TEST_SUPPORT=true
# IM_MACHINE_PATCH=/полный/путь/im-machine-patch.json
